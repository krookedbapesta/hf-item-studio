{
  "name": "hf-item-studio",
  "productName": "HF Item Studio",
  "version": "1.0.0",
  "description": "Create, import, inspect and publish custom House Flipper items without Unity.",
  "main": "main/main.js",
  "type": "commonjs",
  "scripts": {
    "setup": "install-electron",
    "start": "electron .",
    "dev": "node dev/server.cjs",
    "test": "node --test test/*.test.mjs",
    "icon": "node tools/make_icon.mjs build/icon.png 512 && node tools/make_icon.mjs renderer/icon.png 256",
    "dist": "electron-builder --win nsis portable"
  },
  "license": "MIT",
  "dependencies": {
    "fflate": "0.8.3",
    "three": "0.186.1"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "jsdom": "30.1.3"
  },
  "allowScripts": {
    "electron-winstaller": false
  },
  "author": "HF Item Studio",
  "build": {
    "appId": "com.hfitemstudio.app",
    "productName": "HF Item Studio",
    "copyright": "MIT licensed",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "asar": false,
    "files": [
      "main/**",
      "renderer/**",
      "src/**",
      "tools/extract_reference.py",
      "package.json",
      "!**/*.tmp-*"
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "HF-Item-Studio-${version}-${arch}-${target}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "HF Item Studio",
      "artifactName": "HF-Item-Studio-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "HF-Item-Studio-Portable-${version}.${ext}"
    },
    "extraResources": [
      {
        "from": "node_modules/three/examples/jsm",
        "to": "app/node_modules/three/examples/jsm",
        "filter": [
          "**/*"
        ]
      }
    ]
  }
}
